---
import BaseHead from "@/components/BaseHead.astro";
import Navigation from "@/components/global/Navigation.astro";
import Footer from "@/components/global/Footer.astro";
---

<html lang="en" class="selection:bg-orange selection:text-white">
  <head>
    <script is:inline>
      (function () {
        if (window.top !== window.self) return;
        var h = location.hostname;
        if (h === "localhost" || h === "127.0.0.1") return;
        location.replace("https://lexingtonthemes.com/viewports/astromax");
      })();
    </script>
    <BaseHead />
  </head>
  <body
    class="mx-auto bg-black max-w-7xl border-x border-white/20 2xl:max-w-7xl"
  >
    <Navigation />
    <slot />
    <Footer />
  </body>
</html>
